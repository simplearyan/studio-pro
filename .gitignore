# ── Scratch saves, downloads and caches ──────────────────────────────────────
# Stray canvas save at the repo root (the editor's default project name).
# Kept on disk, kept out of git.
/Untitled.json

# Python bytecode from tools/sync_designs.py.
__pycache__/
*.pyc

# Test media (downloaded clips, stills attached to bug reports) belongs in
# _demo_assets/, which is ignored as a folder below — that alone is enough,
# so nothing under docs/ needs a named entry. Stray media in docs/ is
# deliberately NOT ignored: it shows up in git status and gets filed or
# deleted, instead of accumulating behind an ever-growing list of filenames.

# Untracked duplicate of public/vendor/tailwind-browser — Vite serves public/
# at the site root in dev and copies it into dist, so the root copy is dead
# weight. Drop this line if vendored libs ever move to a root vendor/.
/vendor/

# Leftovers from the version-snapshot step in .github/workflows/deploy.yml.
_snap_*/

*.log
Thumbs.db