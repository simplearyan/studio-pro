      "on-variant": "on-variant",
      "accent": "brand",
      "fill-tone": "surface-hi",
      "outline": "outline"
    },
    "theme_map_note": "Only the six roles this film can actually paint. There are no cards, meters, slabs or charts in it, so num-a, meter, fill and slab-ink are deliberately absent rather than mapped to colours nothing reads — a role mapped is a claim the board will print.",
    "fills": {
      "card": "filled",
      "tiles": "tonal",
      "pills": "outlined",
      "answer": "text"
    },
    "fills_note": "`tiles: tonal` so the three aspect cards sit on the paper as quiet surfaces; `pills: outlined` so chips read as swatches, not blocks — which is exactly what the mock's element cards are; `answer: text` so the closing line lands flat.",
    "radii": {
      "pill": "999px",
      "card": "14px",
      "tile": "14px",
      "answer": "0"
    },
    "radii_note": "The mock's cards are rounded-lg on zinc; 14px matches that voice, 999px for chips, square answers.",
