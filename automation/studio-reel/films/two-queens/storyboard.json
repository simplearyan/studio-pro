    {
      "id": "s3", "frame": "step1", "tone": "on-surface", "start": 15, "dur": 9, "exit": "cut",
      "background": { "type": "flat", "base": "#f8faf8" },
      "elements": [
        { "id": "s3-over", "type": "text", "role": "overline", "color": "primary", "text": "Step 1", "at_ms": 150,
          "in": { "type": "fade", "dur_ms": 600 } },
        { "id": "s3-title", "type": "text", "role": "title_hi", "text": "Total possible outcomes", "at_ms": 400,
          "in": { "type": "slide", "from_y": 24, "dur_ms": 700 } },
        { "id": "s3-body", "type": "text", "role": "body", "color": "on-variant",
          "text": "The number of ways to draw any 4 cards from 52 is a straightforward combination.",
          "at_ms": 900, "in": { "type": "fade", "dur_ms": 700 } },
        { "id": "s3-math", "type": "latex", "role": "math",
          "text": "\\binom{52}{4} = \\frac{52!}{4!(52-4)!} = 270{,}725", "at_ms": 1500,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 800 } }
      ]
    },

    {
      "id": "s4", "frame": "step2", "tone": "on-surface", "start": 24, "dur": 10, "exit": "cut",
      "background": { "type": "flat", "base": "#f8faf8" },
      "elements": [
        { "id": "s4-over", "type": "text", "role": "overline", "color": "tertiary", "text": "Step 2", "at_ms": 150,
          "in": { "type": "fade", "dur_ms": 600 } },
        { "id": "s4-title", "type": "text", "role": "title_hi", "text": "Favourable outcomes", "at_ms": 400,
          "in": { "type": "slide", "from_y": 24, "dur_ms": 700 } },
        { "id": "s4-math", "type": "latex", "role": "math_sm", "at_ms": 1000,
          "text": "\\begin{aligned}\\text{The Queens}\\quad &\\binom{4}{2} = 6 \\\\ \\text{The King}\\quad &\\binom{4}{1} = 4 \\\\ \\text{The last card}\\quad &\\binom{44}{1} = 44\\end{aligned}",
          "in": { "type": "slide", "from_y": 24, "dur_ms": 800 } },
        { "id": "s4-body", "type": "text", "role": "body", "color": "on-variant",
          "text": "The last card must be neither Queen nor King, leaving 52 − 4 − 4 = 44 safe cards.",
          "at_ms": 1900, "in": { "type": "fade", "dur_ms": 700 } }
      ]
    },

    {
      "id": "s5", "frame": "step3", "tone": "on-surface", "start": 34, "dur": 10, "exit": "cut",
      "background": { "type": "flat", "base": "#f8faf8" },
      "elements": [
        { "id": "s5-over", "type": "text", "role": "overline", "color": "primary", "text": "Step 3", "at_ms": 150,
          "in": { "type": "fade", "dur_ms": 600 } },
        { "id": "s5-title", "type": "text", "role": "title_hi", "text": "Putting it together", "at_ms": 400,
          "in": { "type": "slide", "from_y": 24, "dur_ms": 700 } },
        { "id": "s5-body", "type": "text", "role": "body", "color": "on-variant",
          "text": "Multiply the favourable combinations and divide by the total.",
          "at_ms": 900, "in": { "type": "fade", "dur_ms": 700 } },
        { "id": "s5-math", "type": "latex", "role": "math_sm", "at_ms": 1500,
          "text": "\\text{Probability} = \\frac{\\binom{4}{2} \\times \\binom{4}{1} \\times \\binom{44}{1}}{\\binom{52}{4}}",
          "in": { "type": "pop", "overshoot": 1.05, "dur_ms": 800 } }
      ]
    },

    {
      "id": "s6", "frame": "numbers", "tone": "on-surface", "start": 44, "dur": 9, "exit": "cut",
      "background": { "type": "flat", "base": "#f8faf8" },
      "elements": [
        { "id": "s6-over", "type": "text", "role": "overline", "color": "primary", "text": "The numbers", "at_ms": 150,
          "in": { "type": "fade", "dur_ms": 600 } },
        { "id": "s6-math", "type": "latex", "role": "math_sm", "at_ms": 700,
          "text": "= \\frac{6 \\times 4 \\times 44}{270{,}725} = \\frac{1{,}056}{270{,}725}",
