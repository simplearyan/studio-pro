      "fill-ink": "white",
      "fill-tone": "tint",
      "outline": "line"
    },
    "fills": {
      "card": "tonal",
      "tiles": "tonal",
      "pills": "outlined",
      "answer": "text"
    },
    "fills_note": "Tonals on paper so panels sit on the page without borders of their own; the cards' accent is blue-ink (7.3:1 on the tint card) because blue at 4.5:1 clears text but looks washed as a meter; pills outlined so six chips do not become six blocks; the closing line is a sentence, not a box.",
