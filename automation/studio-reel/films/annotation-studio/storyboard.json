{
  "meta": {
    "title": "Annotation Studio — draw on anything",
    "id": "annotation-studio",
    "aspect": "16:9",
    "fps": 30,
    "duration": 74,
    "design": "annotation-studio",
    "x_note": "Sixth film, sixth ask: light mode, clean fonts, clean palette — and the design language IS the annotation. Every mark on screen (ring, arrow, underline, box, highlight) is a `shape` element with its own clock, drawn AFTER the words it annotates have settled. First film to use every shape kind the emitter now supports; first light-mode film, so it is also the first whose contrast had to be proven from near-white instead of near-black. Every product fact comes from the v1.3 mock in reference/ — see NOTES.md."
  },
  "design": {
    "style": "annotation studio",
    "x_note": "Light by request. One blue does all the pointing (accent, pills, meters, rings); the four annotation inks — amber, rose, violet, teal — appear ONLY on marks, so colour on screen always means someone circled something. No dark variant: the studio's own panels are dark, but this film is about the marks, and marks read loudest on paper.",
    "tokens": {
      "bg": "#f7f8fa",
      "surface": "#ffffff",
      "surface-hi": "#eef0f4",
      "on-surface": "#131720",
      "on-variant": "#565f6e",
      "outline": "#dfe3e9",
      "outline-var": "#eceef2",
      "brand": "#2563eb",
      "brand-deep": "#1e40af",
      "on-brand": "#ffffff",
      "amber": "#f59e0b",
      "rose": "#f43f5e",
      "violet": "#8b5cf6",
      "teal": "#0d9488"
    },
    "theme_map": {
      "panel": "surface",
      "ink": "on-surface",
      "on-variant": "on-variant",
      "meter": "brand",
      "meter-track": "surface-hi",
      "accent": "brand",
      "num-a": "brand",
      "num-b": "violet",
      "slab-ink": "on-brand",
      "fill": "brand-deep",
      "fill-ink": "on-brand",
      "fill-tone": "surface-hi",
      "outline": "outline"
    },
    "theme_map_note": "num-a/num-b are blue→violet: the stat numeral is a gradient, and an amber numeral on paper would clear large-text AA but look like a warning it is not. The four mark inks (amber, rose, violet, teal) are tokens but deliberately NOT theme roles — a mark colour that resolvable through theme_map would swap with a mode, and a ring changing hue mid-film is not a re-theme, it is a different pen.",
    "fills": {
      "card": "filled",
      "tiles": "tonal",
      "pills": "outlined",
      "answer": "text"
    },
    "fills_note": "`card` is filled because the export scene is three blue slabs of resolution — white numerals on brand is the one move that reads as action — and the fill resolves to brand-deep rather than brand because the panel label rides at 75% opacity: white-on-brand measured 3.61:1 in the real browser and the contrast gate failed it, while one shade deeper clears 4.5:1 without changing what the slab is. `tiles` tonal so the aspect-ratio cards sit on the paper without borders of their own; `pills` outlined so nine chips do not become nine blocks; `answer` text because the closing line is a sentence, not a box.",
    "radii": {
      "pill": "999px",
      "card": "14px",
      "tile": "14px",
      "answer": "0"
    },
    "radii_note": "Soft but not Material: 14px reads as a modern web panel (the mock's own cards are rounded), 999px for chips, and square answers so the closing line lands flat on the paper.",
    "fonts": {
      "display": {
        "family": "Inter",
        "weight": 800,
        "usage": "headlines. The mock's own face — Inter is the UI font of the product, so the film is set in what the studio looks like."
      },
      "overline": {
        "family": "JetBrains Mono",
        "weight": 700
      },
      "body": {
        "family": "Inter",
        "weight": 400
      },
      "lead": {
        "family": "Inter",
        "weight": 400
      },
      "mono": {
        "family": "JetBrains Mono",
        "weight": 500,
        "usage": "tool chips and labels — the machine voice of the toolbar."
      },
      "stat": {
        "family": "Inter",
        "weight": 800
      }
    },
    "font_href": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap",
    "radius": 10,
    "border": "1px solid #e2e6ec",
    "background": {
      "type": "flat",
      "base": "#f7f8fa"
    },
    "text_width": {
      "lead": 1180,
      "body": 1240
    },
    "text_width_note": "The lead is capped 100px tighter than the body: it is the only role that carries a full sentence of product copy per scene, and a two-line lead reads as a standfirst while a three-line one reads as a paragraph."
  },
