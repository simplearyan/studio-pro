{
  "meta": {
    "title": "Studio Pro — the whole studio runs in your browser",
    "id": "studio-pro-showcase",
    "aspect": "16:9",
    "fps": 30,
    "duration": 66,
    "design": "synthwave-brutal",
    "source_mock": "reference/portfolio-mock.html",
    "x_note": "Third film, third design language. Copy is taken from this repo's README/package.json/clip-lite, NOT from the mock, which is a 'Maya Chen' template. See NOTES.md for what the third design proves about the pipeline."
  },

  "design": {
    "style": "synthwave brutalism",
    "tokens": {
      "coal": "#151217",
      "panel": "#211C29",
      "ink": "#15121A",
      "paper": "#FBF6EC",
      "sun": "#FFC93C",
      "coral": "#FF5A5F",
      "teal": "#00A896",
      "violet": "#7B61FF",
      "pink": "#FF6FA5"
    },
    "theme_map": {
      "ink": "paper",
      "slab-ink": "ink",
      "panel": "panel",
      "meter": "teal",
      "accent": "violet",
      "num-a": "teal",
      "num-b": "violet"
    },

    "fonts": {
      "display": { "family": "Inter", "weight": 800, "usage": "the name slab — heavy, reversed out of a block" },
      "display_hi": { "family": "Inter", "weight": 800 },
      "body_hi": { "family": "Inter", "weight": 400, "usage": "all prose" },
      "mono": { "family": "JetBrains Mono", "weight": 700, "usage": "nav, labels, counts, ticker" }
    },
    "font_href": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap",
    "elevation": {
      "sm": "5px 5px 0px 0px rgba(0,0,0,1)",
      "md": "8px 8px 0px 0px rgba(0,0,0,1)",
      "lg": "12px 12px 0px 0px rgba(0,0,0,1)"
    },
    "radius": 0,
    "border": "2px solid #000",
    "background": { "type": "dots", "ink": "#211C29", "size": "32px 32px", "base": "#151217" },
    "hover": "shadow collapse + translate(3px,3px)",
    "x_note": "Same shape as the jan-suraaj design block. theme_map.ink is 'paper' (#FBF6EC), NOT this palette's own 'ink' token (#15121A) — that token means 'dark text on a light surface', and the stage here is near-black. Without the map the compiler fell back to 'coal' (#151217), the page background, and every credit and tile label rendered at 1.0:1. Found by reel-contrast.cjs."
  },

  "frame": {
    "design_space": { "w": 1920, "h": 1080 },
    "safe": { "title": 0.05, "action": 0.03, "max_text_width": 900 },
    "ramp": {
      "display": { "family": "Inter", "size": 140, "weight": 800, "tracking": "-2px", "case": "upper" },
      "display_hi": { "family": "Inter", "size": 120, "weight": 800, "tracking": "-2px", "case": "upper" },
      "lead_hi": { "family": "Inter", "size": 32, "weight": 400 },
      "tag": { "family": "JetBrains Mono", "size": 18, "weight": 700, "case": "upper" }
    },
    "beat": { "hold": 6.0, "long": 9.0 }
  },

  "scenes": [
    {
      "id": "p1", "frame": "title", "tone": "violet", "start": 0, "dur": 7, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p1-badge", "type": "credit", "text": "◆ OPEN SOURCE · MPL-2.0", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#FFC93C" },
        { "id": "p1-name", "type": "text", "role": "display", "text": "STUDIO PRO", "at_ms": 450,
          "style": "slab", "slab_bg": "#7B61FF", "in": { "type": "slide", "from_y": 36, "dur_ms": 800 } },
        { "id": "p1-sub", "type": "text", "role": "lead_hi",
          "text": "A pro-feeling video editor and motion-graphics studio that runs entirely in your browser.",
          "at_ms": 1000, "style": "body", "max_width": 900, "in": { "type": "fade", "dur_ms": 700 } }
      ]
    },

    {
      "id": "p2", "frame": "premise", "tone": "teal", "start": 7, "dur": 7, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p2-badge", "type": "credit", "text": "THE PREMISE", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#00A896" },
        { "id": "p2-head", "type": "text", "role": "display", "text": "NOTHING LEAVES YOUR MACHINE", "at_ms": 500,
          "style": "slab", "slab_bg": "#00A896", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p2-cards", "type": "cards", "at_ms": 1400,
          "in": { "type": "slide", "from_y": 34, "dur_ms": 700, "stagger_ms": 130 },
          "items": [
            { "label": "NO ACCOUNTS", "accent": "#FFC93C" },
            { "label": "NO UPLOADS", "accent": "#FF6FA5" },
            { "label": "NO BACKEND", "accent": "#7B61FF" }
          ] }
      ]
    },

    {
      "id": "p3", "frame": "editor", "tone": "violet", "start": 14, "dur": 8, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p3-badge", "type": "credit", "text": "WORK", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#FFC93C" },
        { "id": "p3-head", "type": "text", "role": "display", "text": "EVERY CLIP TYPE", "at_ms": 500,
          "style": "slab", "slab_bg": "#FFC93C", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p3-tiles", "type": "tiles", "columns": 4,
          "items": [
            { "icon": "T", "head": "Text", "body": "Type, tracks, ramps." },
            { "icon": "◼", "head": "Shapes", "body": "Geometry and fills." },
            { "icon": "▶", "head": "Media", "body": "Image, video, audio." },
            { "icon": "∑", "head": "Math", "body": "KaTeX inline." }
          ],
          "at_ms": 1500, "in": { "type": "slide", "from_y": 34, "dur_ms": 700, "stagger_ms": 90 } },
        { "id": "p3-more", "type": "text", "role": "lead_hi",
          "text": "Plus ink (draw) and HTML-in-Canvas — HTML as a first-class clip type.",
          "at_ms": 2400, "style": "body", "max_width": 900, "in": { "type": "fade", "dur_ms": 700 } }
      ]
    },

    {
      "id": "p4", "frame": "hic", "tone": "pink", "start": 22, "dur": 8, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p4-badge", "type": "credit", "text": "THE ENGINE", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#FF6FA5" },
        { "id": "p4-head", "type": "text", "role": "display", "text": "HTML-IN-CANVAS", "at_ms": 500,
          "style": "slab", "slab_bg": "#FF6FA5", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p4-body", "type": "text", "role": "lead_hi",
          "text": "A clip is plain HTML, CSS and JS in a fixed 800 × 450 design space, rasterised to the timeline. Vanilla only — no framework, no runtime between you and the frame.",
          "at_ms": 1100, "style": "body", "max_width": 940, "in": { "type": "fade", "dur_ms": 700 } },
        { "id": "p4-pills", "type": "pills",
          "items": ["HIC CODE EDITOR", "AI TAB", "VANILLA HTML/CSS/JS"],
          "at_ms": 1800, "in": { "type": "slide", "from_y": 26, "dur_ms": 700, "stagger_ms": 120 },
          "color": "#FF6FA5" }
      ]
    },

    {
      "id": "p5", "frame": "deterministic", "tone": "teal", "start": 30, "dur": 8, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p5-badge", "type": "credit", "text": "WHY IT'S DIFFERENT", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#00A896" },
        { "id": "p5-head", "type": "text", "role": "display", "text": "DETERMINISTIC BY CONSTRUCTION", "at_ms": 500,
          "style": "slab", "slab_bg": "#00A896", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p5-body", "type": "text", "role": "lead_hi",
          "text": "No requestAnimationFrame. No setTimeout. No live CSS animation. A frame is a pure function of its timestamp — which is why scrubbing, deep links and the export gate all agree.",
          "at_ms": 1200, "style": "body", "max_width": 940, "in": { "type": "fade", "dur_ms": 700 } },
        { "id": "p5-stat", "type": "stat", "value": "0", "label": "requestAnimationFrame calls in the export path",
          "at_ms": 2000, "in": { "type": "pop", "overshoot": 1.2, "dur_ms": 700 }, "num_color": "#00A896" }
      ]
    },

    {
      "id": "p6", "frame": "proof", "tone": "coral", "start": 38, "dur": 8, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p6-badge", "type": "credit", "text": "THE PROOF", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#FF5A5F" },
        { "id": "p6-head", "type": "text", "role": "display", "text": "A BREATH OF AIR", "at_ms": 500,
          "style": "slab", "slab_bg": "#FF5A5F", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p6-body", "type": "text", "role": "lead_hi",
          "text": "A 26-second, four-clip film about air pollution — written as HTML and CSS, rendered to MP4 by the terminal pipeline.",
          "at_ms": 1100, "style": "body", "max_width": 900, "in": { "type": "fade", "dur_ms": 700 } },
        { "id": "p6-stat", "type": "stat", "value": "780/780", "label": "frames byte-identical against the reference render",
          "at_ms": 1800, "in": { "type": "pop", "overshoot": 1.15, "dur_ms": 800 }, "num_color": "#FF5A5F" }
      ]
    },

    {
      "id": "p7", "frame": "lite", "tone": "sun", "start": 46, "dur": 8, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p7-badge", "type": "credit", "text": "STUDIO PRO LITE", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#FFC93C" },
        { "id": "p7-head", "type": "text", "role": "display", "text": "ONE FILE", "at_ms": 500,
          "style": "slab", "slab_bg": "#FFC93C", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p7-body", "type": "text", "role": "lead_hi",
          "text": "The same ideas at phone size: import real video, build a filmstrip and waveform from the source, scrub on a pinned playhead, export with MediaRecorder.",
          "at_ms": 1100, "style": "body", "max_width": 900, "in": { "type": "fade", "dur_ms": 700 } },
        { "id": "p7-pills", "type": "pills",
          "items": ["FILMSTRIP", "WAVEFORM", "PINNED PLAYHEAD", "MEDIARECORDER"],
          "at_ms": 1900, "in": { "type": "slide", "from_y": 26, "dur_ms": 700, "stagger_ms": 110 },
          "color": "#FFC93C" }
      ]
    },

    {
      "id": "p8", "frame": "both", "tone": "violet", "start": 54, "dur": 7, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p8-badge", "type": "credit", "text": "ONE PIPELINE", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#7B61FF" },
        { "id": "p8-head", "type": "text", "role": "display", "text": "TWO PRODUCTS", "at_ms": 500,
          "style": "slab", "slab_bg": "#7B61FF", "in": { "type": "slide", "from_y": 30, "dur_ms": 800 } },
        { "id": "p8-cards", "type": "cards", "at_ms": 1400,
          "in": { "type": "slide", "from_y": 34, "dur_ms": 700, "stagger_ms": 140 },
          "items": [
            { "label": "STUDIO PRO — DESKTOP TIMELINE", "accent": "#7B61FF" },
            { "label": "STUDIO PRO LITE — PHONE, ONE FILE", "accent": "#FFC93C" }
          ] },
        { "id": "p8-body", "type": "text", "role": "lead_hi",
          "text": "Same deterministic pipeline, same export gate. One is a studio; the other fits in a pocket.",
          "at_ms": 2100, "style": "body", "max_width": 900, "in": { "type": "fade", "dur_ms": 700 } }
      ]
    },

    {
      "id": "p9", "frame": "creator", "tone": "pink", "start": 61, "dur": 5, "exit": "cut",
      "background": { "type": "dots", "base": "#151217", "ink": "#211C29", "size": "32px 32px" },
      "elements": [
        { "id": "p9-badge", "type": "credit", "text": "◆ BUILT BY ONE PERSON", "at_ms": 200,
          "in": { "type": "slide", "from_y": 22, "dur_ms": 600 }, "style": "label", "color": "#FF6FA5" },
        { "id": "p9-name", "type": "text", "role": "display", "text": "ARYAN", "at_ms": 450,
          "style": "slab", "slab_bg": "#FF6FA5", "in": { "type": "pop", "overshoot": 1.2, "dur_ms": 800 } },
        { "id": "p9-foot", "type": "credit", "text": "SIMPLEARYAN.GITHUB.IO/STUDIO-PRO · MPL-2.0", "at_ms": 1400,
          "in": { "type": "fade", "dur_ms": 700 }, "style": "label" }
      ]
    }
  ]
}